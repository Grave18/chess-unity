<UserControl x:Class="Chess3D.Runtime.Menu.UI.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Ui.Converters"
             xmlns:design="clr-namespace:Blend"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="700" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="Lobby"
               Style="{StaticResource HeaderLabelStyle}" />
        
        <!-- Lobby List -->
        <Border Grid.Row="1"
                Style="{StaticResource SettingsControlsBorder}">
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Height="190"
                     ItemsSource="{Binding LobbyUsers}"
                     ItemTemplate="{StaticResource LobbyUserTemplate}" >
                <d:ListBox.ItemsSource>
                    <x:Array Type="design:DesignLobbyUser">
                        <design:DesignLobbyUser Name="Alice" IsReady="True"/>
                        <design:DesignLobbyUser Name="Bob" IsReady="False"/>
                    </x:Array>
                </d:ListBox.ItemsSource>
            </ListBox>
        </Border>

        <!-- Friends List -->
        <Border Grid.Row="2"
                Style="{StaticResource SettingsControlsBorder}">
            <ListBox ItemsSource="{Binding Friends}"
                        ItemTemplate="{StaticResource FriendUserTemplate}">
            </ListBox>
        </Border>

        <Button Grid.Row="3"
                Margin="0 0 0 20"
                Content="Ready"
                Command="{Binding ReadyCommand}"/>

        <Button Grid.Row="4"
                Name="Back"
                Margin="0 0 0 20"
                Content="Back"
                Command="{Binding BackCommand}" />
    </Grid>

</UserControl>
